.form-panel {
  padding-bottom: 140rpx;
  border: 1rpx solid #f3f4f6;
  box-shadow: none;
}

.field + .field {
  margin-top: 28rpx;
}

.field-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #374151;
}

.field-static,
.field-picker,
.field-input {
  margin-top: 12rpx;
  min-height: 84rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  font-size: 26rpx;
  color: #111827;
}

.field-help {
  margin-top: 10rpx;
  padding: 0 6rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #6b7280;
}

.field-input {
  width: 100%;
}

.suggestions-panel {
  margin-top: 10rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  overflow: hidden;
}

.suggestion-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 22rpx;
}

.suggestion-item + .suggestion-item {
  border-top: 1rpx solid #f3f4f6;
}

.suggestion-name {
  flex: 1;
  font-size: 24rpx;
  color: #111827;
}

.suggestion-district,
.suggestions-empty {
  font-size: 22rpx;
  color: #6b7280;
}

.suggestions-empty {
  padding: 20rpx 22rpx;
}

.option-grid {
  margin-top: 12rpx;
  display: grid;
  gap: 12rpx;
}

.option-grid-five {
  grid-template-columns: repeat(5, minmax(0, 1fr));
}

.option-grid-three {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.option-chip {
  min-height: 76rpx;
  border-radius: 18rpx;
  background: #f9fafb;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #374151;
}

.option-chip-active {
  background: #2563eb;
  color: #ffffff;
}

.tips-box {
  margin-top: 28rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #eff6ff;
}

.tips-line {
  font-size: 22rpx;
  line-height: 1.7;
  color: #1d4ed8;
}

.save-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #f3f4f6;
}

.save-button {
  width: 100%;
  height: 78rpx;
  margin: 0;
  padding: 0;
  border-radius: 18rpx;
  background: #8ea8f4;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 78rpx;
}

.save-button-active {
  background: #2563eb;
  opacity: 1;
}

.save-button::after {
  border: none;
}

.save-button-disabled {
  background: #8ea8f4;
  opacity: 0.72;
}
