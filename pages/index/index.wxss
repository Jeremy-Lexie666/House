.container {
  display: flex;
  flex-direction: column;
}

.sticky-shell {
  position: sticky;
  top: 0;
  z-index: 8;
  margin: -28rpx -24rpx 0;
  padding: 0 24rpx 12rpx;
  background: #f3f4f6;
}

.topbar-title {
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: 600;
  color: #111827;
}

.status-line,
.property-subtitle,
.property-meta,
.property-update {
  font-size: 22rpx;
  line-height: 1.6;
  color: #6b7280;
}

.header-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0 14rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f3f4f6;
}

.header-copy {
  flex: 1;
  padding-left: 10rpx;
}

.topbar-actions {
  display: flex;
  gap: 8rpx;
  margin-left: 16rpx;
}

.icon-button {
  width: 112rpx;
  height: 112rpx;
  border-radius: 28rpx;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #111827;
}

.button-icon {
  font-size: 48rpx;
  line-height: 1;
  color: #6b7280;
}

.refresh-icon {
  font-size: 50rpx;
}

.button-stack {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.button-label {
  font-size: 18rpx;
  line-height: 1;
  color: #9ca3af;
}

.icon-button-disabled {
  opacity: 0.7;
}

.status-line {
  margin-top: 0;
}

.sort-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 0 16rpx 10rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f3f4f6;
}

.sort-icon,
.sort-text {
  font-size: 22rpx;
  color: #6b7280;
}

.property-card {
  margin-top: 12rpx;
  padding: 28rpx;
  border: 1rpx solid #f3f4f6;
  border-radius: 20rpx;
  box-shadow: none;
}

.property-card-top {
  align-items: flex-start;
}

.property-title-wrap {
  flex: 1;
  min-width: 0;
}

.property-title {
  font-size: 28rpx;
  line-height: 1.5;
  color: #111827;
  font-weight: 500;
}

.property-data-badge {
  display: inline-flex;
  align-items: center;
  margin-top: 10rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1;
  font-weight: 500;
}

.property-data-badge-real {
  background: #eff6ff;
  color: #2563eb;
}

.property-data-badge-sample {
  background: #fff7ed;
  color: #c2410c;
}

.property-source {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #9ca3af;
  font-weight: 500;
}

.property-subtitle {
  margin-top: 10rpx;
}

.property-price-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 18rpx;
}

.property-total {
  font-size: 36rpx;
  color: #ef4444;
  font-weight: 600;
}

.property-unit {
  font-size: 22rpx;
  color: #6b7280;
}

.property-meta {
  margin-top: 12rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.chip {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1.2;
  color: #6b7280;
  background: #f3f4f6;
}

.chip-warn {
  color: #c2410c;
  background: #fff7ed;
}

.property-update {
  margin-top: 14rpx;
}

.empty-fill {
  flex: 1;
  display: flex;
  min-height: 0;
}

.loading-fill {
  flex: 1;
  display: flex;
  min-height: 0;
}

.loading-state,
.empty-state {
  flex: 1;
  margin-top: 12rpx;
  padding: 0 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.loading-spinner {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(37, 99, 235, 0.16);
  border-top-color: #2563eb;
  animation: spin 0.9s linear infinite;
}

.empty-icon {
  font-size: 76rpx;
  line-height: 1;
}

.loading-title,
.empty-title {
  margin-top: 20rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: #6b7280;
  text-align: center;
}

.loading-desc,
.empty-desc {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #9ca3af;
  text-align: center;
}

.empty-action {
  width: 360rpx;
  height: 78rpx;
  margin-top: 28rpx;
  padding: 0;
  border-radius: 18rpx;
  background: #2563eb;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 78rpx;
}

.empty-action::after {
  border: none;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}
