<view class="container">
  <view class="sticky-shell">
    <view class="header-card">
      <view class="header-copy">
        <view class="status-line">最近更新于 {{lastRefreshedAt}} · 共 {{propertyCount}} 套房源</view>
      </view>
      <view class="topbar-actions">
        <view class="icon-button" bindtap="openManage">
          <view class="button-stack">
            <view class="button-icon">⚙</view>
            <view class="button-label">设置</view>
          </view>
        </view>
        <view class="icon-button {{refreshing ? 'icon-button-disabled' : ''}}" bindtap="handleRefresh">
          <view class="button-stack">
            <view class="button-icon refresh-icon">↻</view>
            <view class="button-label">{{refreshing ? '抓取中' : '刷新'}}</view>
          </view>
        </view>
      </view>
    </view>
    <view class="sort-row">
      <view class="sort-icon">⇅</view>
      <view class="sort-text">按总价从低到高</view>
    </view>
  </view>

  <view class="loading-fill" wx:if="{{loading && !properties.length}}">
    <view class="panel loading-state">
      <view class="loading-spinner"></view>
      <view class="loading-title">正在加载房源数据</view>
      <view class="loading-desc">请稍候，系统正在同步当前关注条件下的最新房源。</view>
    </view>
  </view>

  <block wx:elif="{{properties.length}}">
    <block wx:for="{{properties}}" wx:key="id">
      <view class="panel property-card" bindtap="openProperty" data-id="{{item.id}}">
        <view class="row between property-card-top">
          <view class="property-title-wrap">
            <view class="property-title">{{item.displayTitle}}</view>
            <view class="property-data-badge {{item.dataClassName}}">{{item.dataLabel}}</view>
          </view>
          <view class="property-source">{{item.source}}</view>
        </view>

        <view class="property-subtitle">{{item.subtitle}}</view>

        <view class="property-price-row">
          <view class="property-total">{{item.totalLabel}}</view>
          <view class="property-unit">{{item.unitLabel}}</view>
        </view>

        <view class="property-meta">{{item.metaLine}}</view>

        <view class="chip-row">
          <block wx:for="{{item.tags}}" wx:key="*this">
            <view class="chip {{item === '降价' ? 'chip-warn' : ''}}">{{item}}</view>
          </block>
        </view>

        <view class="property-update">更新于 {{item.updateLabel}}</view>
      </view>
    </block>
  </block>

  <view class="empty-fill" wx:else>
    <view class="panel empty-state">
      <view class="empty-icon">🏡</view>
      <view class="empty-title">{{watchCount > 0 ? '暂未抓到真实房源' : '尚未添加关注房源'}}</view>
      <view class="empty-desc" wx:if="{{watchCount > 0}}">当前关注条件下还没有抓到贝壳真实房源，可以稍后刷新或检查关注条件。</view>
      <button class="empty-action" bindtap="handleEmptyAction">{{watchCount > 0 ? '管理关注' : '添加关注'}}</button>
    </view>
  </view>
</view>
