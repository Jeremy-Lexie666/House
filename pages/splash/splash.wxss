.splash-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 36%, rgba(32, 119, 255, 0.22), transparent 34%),
    radial-gradient(circle at 50% 78%, rgba(22, 145, 255, 0.18), transparent 28%),
    linear-gradient(180deg, #050c1f 0%, #06122b 42%, #071c46 100%);
  color: #ffffff;
}

.splash-grid {
  position: absolute;
  inset: auto 0 0;
  height: 42%;
  background-image:
    linear-gradient(rgba(75, 157, 255, 0.08) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(75, 157, 255, 0.08) 1rpx, transparent 1rpx);
  background-size: 56rpx 56rpx;
  opacity: 0.7;
  transform: perspective(900rpx) rotateX(73deg) scale(1.5);
  transform-origin: center bottom;
}

.splash-aurora {
  position: absolute;
  width: 380rpx;
  height: 380rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(31, 142, 255, 0.16) 0%, rgba(31, 142, 255, 0) 70%);
  filter: blur(16rpx);
}

.splash-aurora-left {
  top: 120rpx;
  left: -120rpx;
}

.splash-aurora-right {
  top: 80rpx;
  right: -120rpx;
}

.splash-arc {
  position: absolute;
  left: 50%;
  border: 1rpx solid rgba(63, 141, 255, 0.18);
  border-radius: 50%;
  transform: translateX(-50%);
}

.splash-arc-outer {
  top: 42rpx;
  width: 900rpx;
  height: 560rpx;
}

.splash-arc-inner {
  top: 110rpx;
  width: 720rpx;
  height: 420rpx;
}

.dashboard {
  position: absolute;
  width: 190rpx;
  min-height: 180rpx;
  padding: 20rpx 18rpx;
  border: 1rpx solid rgba(57, 132, 255, 0.28);
  border-radius: 22rpx;
  background: linear-gradient(180deg, rgba(8, 26, 68, 0.4), rgba(7, 20, 49, 0.16));
  box-shadow: inset 0 0 32rpx rgba(23, 123, 255, 0.08);
}

.dashboard-left {
  left: 28rpx;
}

.dashboard-right {
  right: 28rpx;
}

.dashboard-top {
  top: 470rpx;
}

.dashboard-bottom {
  top: 700rpx;
}

.dashboard-title {
  color: #54c1ff;
  font-size: 26rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.chart {
  position: relative;
  height: 120rpx;
}

.chart-line-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(77, 154, 255, 0.08) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(77, 154, 255, 0.08) 1rpx, transparent 1rpx);
  background-size: 28rpx 28rpx;
}

.chart-line-path {
  position: absolute;
  left: 12rpx;
  right: 12rpx;
  bottom: 34rpx;
  height: 2rpx;
  background: linear-gradient(90deg, rgba(50, 152, 255, 0.1), #43c8ff 30%, #81dcff 55%, #43c8ff 100%);
  transform: skewY(-18deg);
  box-shadow: 0 0 10rpx rgba(63, 196, 255, 0.7);
}

.chart-bars {
  position: absolute;
  left: 12rpx;
  right: 12rpx;
  bottom: 0;
  display: flex;
  align-items: flex-end;
  gap: 10rpx;
}

.bar {
  flex: 1;
  border-radius: 10rpx 10rpx 0 0;
  background: linear-gradient(180deg, rgba(86, 213, 255, 0.95), rgba(35, 96, 255, 0.48));
}

.bar-1 { height: 28rpx; }
.bar-2 { height: 52rpx; }
.bar-3 { height: 40rpx; }
.bar-4 { height: 74rpx; }
.bar-5 { height: 96rpx; }

.chart-ring {
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: conic-gradient(#3fd5ff 0deg, #2f87ff 280deg, rgba(47, 135, 255, 0.18) 280deg);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 24rpx rgba(57, 177, 255, 0.28);
}

.ring-inner {
  width: 82rpx;
  height: 82rpx;
  border-radius: 50%;
  background: rgba(6, 20, 52, 0.92);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring-value {
  color: #55d1ff;
  font-size: 30rpx;
  font-weight: 600;
}

.chart-map {
  overflow: hidden;
}

.map-shape {
  position: absolute;
  inset: 10rpx;
  border-radius: 40% 48% 44% 50%;
  border: 1rpx solid rgba(80, 176, 255, 0.42);
  transform: rotate(-10deg);
}

.map-point {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #62deff;
  box-shadow: 0 0 14rpx rgba(98, 222, 255, 0.9);
}

.map-point-1 { top: 30rpx; left: 44rpx; }
.map-point-2 { top: 62rpx; right: 34rpx; }
.map-point-3 { bottom: 26rpx; left: 76rpx; }

.bars-mini {
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  bottom: 6rpx;
  display: flex;
  align-items: flex-end;
  gap: 10rpx;
}

.mini-bar {
  flex: 1;
  border-radius: 8rpx 8rpx 0 0;
  background: linear-gradient(180deg, rgba(88, 222, 255, 0.95), rgba(58, 121, 255, 0.48));
}

.mini-bar-1 { height: 22rpx; }
.mini-bar-2 { height: 34rpx; }
.mini-bar-3 { height: 54rpx; }
.mini-bar-4 { height: 42rpx; }
.mini-bar-5 { height: 70rpx; }
.mini-bar-6 { height: 82rpx; }

.brand-block {
  position: relative;
  z-index: 2;
  padding-top: 176rpx;
  text-align: center;
}

.logo-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 26rpx;
}

.logo-house {
  position: relative;
  width: 170rpx;
  height: 156rpx;
  border-radius: 26rpx;
  background: linear-gradient(180deg, #5ce7ff 0%, #1b87ff 100%);
  clip-path: polygon(50% 0%, 96% 34%, 96% 100%, 4% 100%, 4% 34%);
  box-shadow: 0 0 28rpx rgba(71, 196, 255, 0.5);
}

.logo-house::after {
  content: "";
  position: absolute;
  inset: 18rpx;
  border-radius: 18rpx;
  background: #07183f;
  clip-path: polygon(50% 0%, 96% 34%, 96% 100%, 4% 100%, 4% 34%);
}

.logo-window,
.logo-bar {
  position: absolute;
  z-index: 1;
  border-radius: 8rpx;
  background: linear-gradient(180deg, #6beeff, #2d95ff);
}

.logo-window { width: 14rpx; height: 14rpx; top: 48rpx; }
.logo-window-1 { left: 66rpx; }
.logo-window-2 { left: 86rpx; }
.logo-window-3 { top: 68rpx; left: 66rpx; }
.logo-window-4 { top: 68rpx; left: 86rpx; }

.logo-bar { bottom: 30rpx; width: 24rpx; }
.logo-bar-1 { left: 44rpx; height: 42rpx; }
.logo-bar-2 { left: 78rpx; height: 66rpx; }
.logo-bar-3 { left: 112rpx; height: 94rpx; }

.brand-title {
  font-size: 88rpx;
  line-height: 1.04;
  font-weight: 700;
  letter-spacing: 0;
  text-shadow: 0 10rpx 22rpx rgba(0, 0, 0, 0.36);
}

.brand-subtitle {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.subtitle-line {
  width: 86rpx;
  height: 2rpx;
  background: linear-gradient(90deg, rgba(95, 191, 255, 0), rgba(95, 191, 255, 0.92), rgba(95, 191, 255, 0));
}

.subtitle-text {
  color: rgba(238, 247, 255, 0.96);
  font-size: 32rpx;
  font-weight: 500;
}

.brand-caption {
  margin-top: 28rpx;
  color: rgba(238, 247, 255, 0.92);
  font-size: 32rpx;
  letter-spacing: 12rpx;
  padding-left: 12rpx;
}

.city-stage {
  position: relative;
  margin-top: 84rpx;
  height: 520rpx;
}

.beam {
  position: absolute;
  bottom: 96rpx;
  width: 2rpx;
  background: linear-gradient(180deg, rgba(76, 166, 255, 0), rgba(76, 166, 255, 0.95), rgba(76, 166, 255, 0));
  box-shadow: 0 0 16rpx rgba(76, 166, 255, 0.64);
}

.beam-1 { left: 140rpx; height: 220rpx; }
.beam-2 { left: 220rpx; height: 160rpx; }
.beam-3 { left: 300rpx; height: 280rpx; }
.beam-4 { right: 300rpx; height: 300rpx; }
.beam-5 { right: 220rpx; height: 180rpx; }
.beam-6 { right: 140rpx; height: 240rpx; }

.cityline {
  position: absolute;
  left: 56rpx;
  right: 56rpx;
  bottom: 110rpx;
  height: 250rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.building {
  position: relative;
  border-radius: 12rpx 12rpx 0 0;
  background: linear-gradient(180deg, rgba(67, 211, 255, 0.92), rgba(20, 80, 200, 0.4) 18%, rgba(10, 29, 72, 0.86) 100%);
  box-shadow: 0 0 16rpx rgba(45, 159, 255, 0.2);
}

.building::after {
  content: "";
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  top: 18rpx;
  bottom: 12rpx;
  background-image: linear-gradient(rgba(110, 220, 255, 0.26) 1rpx, transparent 1rpx);
  background-size: 100% 16rpx;
  opacity: 0.45;
}

.building-1 { width: 30rpx; height: 90rpx; }
.building-2 { width: 36rpx; height: 120rpx; }
.building-3 { width: 42rpx; height: 158rpx; }
.building-4 { width: 54rpx; height: 224rpx; }
.building-5 { width: 36rpx; height: 132rpx; }
.building-6 { width: 62rpx; height: 250rpx; }
.building-7 { width: 42rpx; height: 168rpx; }
.building-8 { width: 34rpx; height: 118rpx; }
.building-9 { width: 28rpx; height: 86rpx; }
.building-10 { width: 24rpx; height: 66rpx; }

.platform {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  border-radius: 50%;
  border: 2rpx solid rgba(83, 202, 255, 0.92);
  box-shadow: 0 0 24rpx rgba(67, 193, 255, 0.4);
}

.platform-outer {
  bottom: 24rpx;
  width: 560rpx;
  height: 120rpx;
}

.platform-middle {
  bottom: 38rpx;
  width: 420rpx;
  height: 88rpx;
}

.platform-inner {
  bottom: 50rpx;
  width: 290rpx;
  height: 60rpx;
}

.loading-block {
  position: relative;
  z-index: 2;
  margin-top: 10rpx;
  padding: 0 118rpx 90rpx;
}

.loading-text {
  text-align: center;
  color: rgba(247, 250, 255, 0.96);
  font-size: 38rpx;
  margin-bottom: 24rpx;
}

.progress-track {
  position: relative;
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(181, 213, 255, 0.22);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  width: 12%;
  border-radius: inherit;
  background: linear-gradient(90deg, #207cff 0%, #59dbff 100%);
  box-shadow: 0 0 18rpx rgba(89, 219, 255, 0.75);
  transition: width 2s ease;
}

.progress-glow {
  position: absolute;
  top: 50%;
  right: 0;
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background: radial-gradient(circle, #ffffff 0%, #81ecff 52%, rgba(129, 236, 255, 0) 72%);
  transform: translate(30%, -50%);
  box-shadow: 0 0 24rpx rgba(129, 236, 255, 0.8);
}
