.detail-shell {
  padding-bottom: 140rpx;
}

.media-panel {
  padding: 0;
  overflow: hidden;
  border-radius: 0;
  box-shadow: none;
}

.media-swiper {
  height: 420rpx;
}

.media-card {
  height: 100%;
  padding: 26rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #d1d5db 0%, #9ca3af 100%);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.media-top {
  align-items: flex-start;
}

.media-badge {
  align-self: flex-start;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(17, 24, 39, 0.45);
  color: #ffffff;
  font-size: 22rpx;
}

.media-count {
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(17, 24, 39, 0.45);
  color: #ffffff;
  font-size: 22rpx;
}

.media-caption,
.info-label,
.summary-meta-row,
.detail-info-line {
  font-size: 24rpx;
  line-height: 1.6;
  color: #6b7280;
}

.media-caption {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 500;
}

.detail-panel,
.info-panel,
.summary-panel {
  margin-top: 18rpx;
  box-shadow: none;
  border: 1rpx solid #f3f4f6;
}

.detail-price-row {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.detail-total {
  font-size: 52rpx;
  font-weight: 600;
  color: #ef4444;
}

.detail-unit {
  font-size: 24rpx;
  color: #6b7280;
}

.detail-drop {
  display: inline-flex;
  margin-top: 18rpx;
  padding: 8rpx 16rpx;
  border-radius: 14rpx;
  background: #fff7ed;
  color: #c2410c;
  font-size: 22rpx;
}

.detail-data-badge {
  display: inline-flex;
  align-items: center;
  margin-top: 18rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 500;
}

.detail-data-badge-real {
  background: #eff6ff;
  color: #2563eb;
}

.detail-data-badge-sample {
  background: #fff7ed;
  color: #c2410c;
}

.detail-title {
  margin-top: 18rpx;
  font-size: 32rpx;
  line-height: 1.45;
  color: #111827;
  font-weight: 500;
}

.detail-info-line {
  margin-top: 12rpx;
}

.detail-key {
  display: inline-block;
  width: 120rpx;
  color: #9ca3af;
}

.subtle {
  color: #9ca3af;
}

.section-caption {
  margin-bottom: 18rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #111827;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx 12rpx;
}

.info-item {
  padding: 18rpx;
  border-radius: 18rpx;
  background: #f9fafb;
}

.info-value,
.summary-title {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #111827;
  font-weight: 500;
}

.summary-meta-row + .summary-meta-row {
  margin-top: 10rpx;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 18rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #f3f4f6;
}

.detail-button {
  flex: 1;
  height: 78rpx;
  margin: 0;
  padding: 0;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 78rpx;
  box-sizing: border-box;
}

.detail-button::after {
  border: none;
}

.detail-button-secondary {
  background: #f3f4f6;
  color: #1f2937;
}

.detail-button-primary {
  background: #2563eb;
  color: #ffffff;
}

.detail-button-inner {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.detail-button-icon {
  font-size: 24rpx;
}
