.watch-card {
  margin-top: 12rpx;
  padding: 30rpx;
  border: 1rpx solid #f3f4f6;
  box-shadow: none;
}

.watch-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #111827;
}

.watch-summary,
.watch-update {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #6b7280;
}

.watch-summary.subtle {
  margin-top: 4rpx;
  color: #9ca3af;
}

.watch-actions {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f3f4f6;
}

.watch-tools {
  gap: 12rpx;
}

.tool-button {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: #f9fafb;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #111827;
  font-size: 22rpx;
}

.tool-button.danger {
  background: #fff1f2;
  color: #e11d48;
}

.bottom-bar {
  position: sticky;
  bottom: 0;
  padding: 18rpx 0 calc(18rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, #f3f4f6 80%, rgba(243, 244, 246, 0));
}

.manage-add-button {
  width: 100%;
  height: 78rpx;
  margin: 0;
  padding: 0;
  border-radius: 18rpx;
  background: #2563eb;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 78rpx;
}

.manage-add-button::after {
  border: none;
}

.manage-add-inner {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.manage-add-plus {
  font-size: 32rpx;
}

.empty-button {
  width: 100%;
  margin-top: 22rpx;
}
