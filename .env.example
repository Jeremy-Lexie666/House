NODE_ENV=production
HOST=0.0.0.0
PORT=8787
ALLOW_ORIGIN=https://servicewechat.com
STORE_PATH=./backend/data/store.prod.json
SEED_MODE=empty
AUTO_REFRESH_ENABLED=true
AUTO_REFRESH_HOUR=0
AUTO_REFRESH_MINUTE=30
SYNC_MODE=server
INTERNAL_SYNC_TOKEN=replace-with-a-long-random-token
BEIKE_BROWSER_ENABLED=true
BEIKE_BROWSER_HEADLESS=true
BEIKE_BROWSER_CDP_URL=
BEIKE_BROWSER_SESSION_DIR=./backend/data/browser-session/beike
BEIKE_COOKIES_PATH=./backend/data/browser-session/beike-cookies.json
BEIKE_CHROME_PATH=/usr/bin/google-chrome-stable
WORKER_API_BASE_URL=https://api.example.com
WORKER_INTERVAL_MS=300000
WORKER_MIN_SYNC_INTERVAL_MS=900000
